{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "东尼菜市场",
  "version": "1.0.5",
  "identifier": "com.dongni.marketstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "东尼菜市场",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "本地优先的专业图片编辑器",
    "longDescription": "东尼菜市场支持图层、画板、抠图、滤镜、PSD和本地工作流。",
    "copyright": "Copyright © 2026 Dongni Market Studio",
    "category": "GraphicsAndDesign",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
