# Supabase 免费项目：Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# GitHub Actions 会自动写入仓库名，例如 owner/dongni-market-studio
VITE_GITHUB_REPOSITORY=OWNER/dongni-market-studio

# GitHub Pages 地址，不购买域名时使用 github.io 地址
VITE_AUTH_REDIRECT_URL=https://OWNER.github.io/dongni-market-studio

# 生产构建必须保持 true；缺少 Supabase 配置时直接失败
VITE_REQUIRE_AUTH_CONFIG=true

# desktop 或 web；GitHub工作流会自动设置
VITE_APP_TARGET=web
